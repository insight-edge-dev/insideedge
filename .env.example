# Copy to .env.local for local development. Set the same keys in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are embedded in the browser bundle — never put secrets in them.

# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.insideedge.in.net
# "production" allows indexing. Leave unset on Vercel (VERCEL_ENV is used: previews get noindex).
NEXT_PUBLIC_SITE_ENV=
# Show draft case studies / articles (never enable in production)
NEXT_PUBLIC_SHOW_DRAFTS=false

# ── Contact (see src/config/site.ts for the defaults) ─
NEXT_PUBLIC_WHATSAPP_NUMBER=917577012300
NEXT_PUBLIC_PRIMARY_PHONE_E164=+917577012300
NEXT_PUBLIC_PRIMARY_PHONE_DISPLAY="+91 75770 12300"
NEXT_PUBLIC_SECONDARY_WHATSAPP_NUMBER=917086047498
NEXT_PUBLIC_SECONDARY_PHONE_E164=+917086047498
NEXT_PUBLIC_SECONDARY_PHONE_DISPLAY="+91 70860 47498"
NEXT_PUBLIC_CONTACT_EMAIL=contact@insideedgellp.com
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://share.google/MZp6fsnmTQe8S8YZw
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# Showreel: compressed MP4 (6–12 s, < 4 MB) + poster image. Homepage section hidden until set.
NEXT_PUBLIC_SHOWREEL_URL=
NEXT_PUBLIC_SHOWREEL_POSTER=

# ── Analytics (all optional) ─────────────────────────
# Use GTM *or* GA4 directly. If GTM is set, configure GA4 inside GTM and leave GA_ID empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
# Defaults to the existing InsideEdge Pixel (966296406185417) when unset.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Lead delivery (server-only secrets) ──────────────
# At least one channel is required in production, otherwise the form shows a WhatsApp fallback.
# Option A — Resend (recommended)
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "InsideEdge Website <leads@insideedge.in.net>"
LEAD_FROM_EMAIL=
# Option B — EmailJS REST API (keeps the previous EmailJS template working, server-side)
# Enable "Allow EmailJS API for non-browser applications" in EmailJS → Account → Security.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional — also POST each lead as JSON to a CRM / Google Apps Script / Zapier / Make webhook
LEAD_WEBHOOK_URL=

# ── Bot protection (optional, recommended) ───────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
