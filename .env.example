# Copy this file to .env.local for local development.
# Set real production values in Vercel. Never commit local environment files.
# NEXT_PUBLIC_* values are embedded in browser code and must never contain secrets.

# SITE
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Leave unset on Vercel; VERCEL_ENV controls production/preview indexing.
NEXT_PUBLIC_SITE_ENV=
# Never enable draft content in production.
NEXT_PUBLIC_SHOW_DRAFTS=false

# CONTACT
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PRIMARY_PHONE_E164=
NEXT_PUBLIC_PRIMARY_PHONE_DISPLAY=
NEXT_PUBLIC_SECONDARY_WHATSAPP_NUMBER=
NEXT_PUBLIC_SECONDARY_PHONE_E164=
NEXT_PUBLIC_SECONDARY_PHONE_DISPLAY=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# SOCIAL
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ANALYTICS — all optional
# Configure GA4 inside GTM when using NEXT_PUBLIC_GTM_ID; otherwise use NEXT_PUBLIC_GA_ID directly.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# LEAD DELIVERY — server-only except where explicitly prefixed NEXT_PUBLIC_
# Resend is the recommended production delivery channel.
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Example format after the sending domain is verified: Website <leads@example.com>
LEAD_FROM_EMAIL=

# Optional EmailJS server-side compatibility channel
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# OPTIONAL INTEGRATIONS
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_SHOWREEL_URL=
NEXT_PUBLIC_SHOWREEL_POSTER=
LEAD_WEBHOOK_URL=

# BOT PROTECTION
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
